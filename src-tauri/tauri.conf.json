{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atray",
  "version": "0.1.0",
  "identifier": "com.atray",
  "build": {
    "frontendDist": "frontend-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "atray",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/atray.ico",
      "icons/icon.png"
    ]
  }
}
